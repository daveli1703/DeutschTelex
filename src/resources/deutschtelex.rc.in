#include "@CMAKE_CURRENT_SOURCE_DIR@/src/resources/resource.h"
#include <winver.h>

IDI_DEUTSCHTELEX ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/resources/de-language-icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DeutschTelex Project\0"
            VALUE "FileDescription", "DeutschTelex German Telex Input Method\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "DeutschTelex\0"
            VALUE "LegalCopyright", "Copyright (c) DeutschTelex contributors\0"
            VALUE "OriginalFilename", "DeutschTelex.exe\0"
            VALUE "ProductName", "DeutschTelex\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
